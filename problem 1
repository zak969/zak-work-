#include <iostream>
using namespace std;

int main()
{
    int age;
    char nationality;

    cout << "Enter your age: ";
    cin >> age;

    cout << "Are you Pakistani? (Y/N): ";
    cin >> nationality;

    if (age >= 18)
    {
        if (nationality == 'Y' || nationality == 'y')
        {
            cout << "You are eligible to vote.";
        }
        else
        {
            cout << "You are not a Pakistani citizen.";
        }
    }
    else
    {
        cout << "You are under 18 years old.";
    }

    return 0;
}
