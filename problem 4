#include <iostream>
using namespace std;

int main()
{
    int choice;

    cout << "1. Circle" << endl;
    cout << "2. Rectangle" << endl;
    cout << "3. Triangle" << endl;
    cout << "Enter your choice: ";
    cin >> choice;

    switch (choice)
    {
        case 1:
            cout << "You selected Circle.";
            break;

        case 2:
            cout << "You selected Rectangle.";
            break;

        case 3:
            cout << "You selected Triangle.";
            break;

        default:
            cout << "Invalid Choice.";
    }

    return 0;
}
