#include <iostream>
using namespace std;

int main()
{
    float cgpa;
    char income;

    cout << "Enter your CGPA: ";
    cin >> cgpa;

    cout << "Is your family income low? (Y/N): ";
    cin >> income;

    if (cgpa >= 3.5)
    {
        if (income == 'Y' || income == 'y')
        {
            cout << "You are eligible for a scholarship.";
        }
        else
        {
            cout << "CGPA is good, but income criteria not met.";
        }
    }
    else
    {
        cout << "CGPA is too low for a scholarship.";
    }

    return 0;
}
