#include <iostream>
using namespace std;

int main()
{
    int units;

    cout << "Enter electricity units: ";
    cin >> units;

    if (units <= 100)
    {
        cout << "Low Bill";
    }
    else if (units <= 200)
    {
        cout << "Medium Bill";
    }
    else if (units <= 300)
    {
        cout << "High Bill";
    }
    else
    {
        cout << "Very High Bill";
    }

    return 0;
}
