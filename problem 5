#include <iostream>
using namespace std;

int main()
{
    char ch;

    cout << "Enter a vowel (A, E, I, O, U): ";
    cin >> ch;

    switch(ch)
    {
        case 'A':
        case 'a':
            cout << "You entered A";
            break;

        case 'E':
        case 'e':
            cout << "You entered E";
            break;

        case 'I':
        case 'i':
            cout << "You entered I";
            break;

        case 'O':
        case 'o':
            cout << "You entered O";
            break;

        case 'U':
        case 'u':
            cout << "You entered U";
            break;

        default:
            cout << "Not a vowel";
    }

    return 0;
}
