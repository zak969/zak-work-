#include <iostream>
using namespace std;

int main()
{
    int marks, attendance;

    cout << "Enter marks: ";
    cin >> marks;

    cout << "Enter attendance percentage: ";
    cin >> attendance;

    if (marks >= 50)
    {
        if (attendance >= 75)
        {
            cout << "You passed the exam.";
        }
        else
        {
            cout << "Insufficient attendance.";
        }
    }
    else
    {
        cout << "You failed the exam.";
    }

    return 0;
}
