using namespace std;

int main()
{
    int age;
    char student;

    cout << "Enter your age: ";
    cin >> age;

    cout << "Are you a student? (Y/N): ";
    cin >> student;

    if (age >= 16)
    {
        if (student == 'Y' || student == 'y')
        {
            cout << "You can get a library membership.";
        }
        else
        {
            cout << "Only students are eligible.";
        }
    }
    else
    {
        cout << "You must be at least 16 years old.";
    }

    return 0;
}
