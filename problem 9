#include <iostream>
using namespace std;

int main()
{
    int choice;

    cout << "1. Spring" << endl;
    cout << "2. Summer" << endl;
    cout << "3. Autumn" << endl;
    cout << "4. Winter" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    switch(choice)
    {
        case 1:
            cout << "You selected Spring.";
            break;

        case 2:
            cout << "You selected Summer.";
            break;

        case 3:
            cout << "You selected Autumn.";
            break;

        case 4:
            cout << "You selected Winter.";
            break;

        default:
            cout << "Invalid Choice.";
    }

    return 0;
}
