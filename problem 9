int main()
{
    int percentage;

    cout << "Enter your percentage: ";
    cin >> percentage;

    if (percentage >= 80)
    {
        cout << "First Division";
    }
    else if (percentage >= 60)
    {
        cout << "Second Division";
    }
    else if (percentage >= 40)
    {
        cout << "Third Division";
    }
    else
    {
        cout << "Fail";
    }

    return 0;
}
