#include <iostream>
using namespace std;

int main()
{
    int temp;

    cout << "Enter temperature: ";
    cin >> temp;

    if (temp >= 40)
    {
        cout << "Very Hot";
    }
    else if (temp >= 30)
    {
        cout << "Hot";
    }
    else if (temp >= 20)
    {
        cout << "Warm";
    }
    else if (temp >= 10)
    {
        cout << "Cold";
    }
    else
    {
        cout << "Very Cold";
    }

    return 0;
}
