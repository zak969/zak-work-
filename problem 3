#include <iostream>
using namespace std;

int main()
{
    int age;
    char graduate;

    cout << "Enter your age: ";
    cin >> age;

    cout << "Are you a graduate? (Y/N): ";
    cin >> graduate;

    if (age >= 21)
    {
        if (graduate == 'Y' || graduate == 'y')
        {
            cout << "You can apply for the government job.";
        }
        else
        {
            cout << "Graduation is required.";
        }
    }
    else
    {
        cout << "You must be at least 21 years old.";
    }

    return 0;
}
