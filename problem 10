#include <iostream>
using namespace std;

int main()
{
    int age;
    char fit;

    cout << "Enter your age: ";
    cin >> age;

    cout << "Are you medically fit? (Y/N): ";
    cin >> fit;

    if (age >= 18)
    {
        if (fit == 'Y' || fit == 'y')
        {
            cout << "You are eligible to join the sports team.";
        }
        else
        {
            cout << "You must be medically fit.";
        }
    }
    else
    {
        cout << "You must be at least 18 years old.";
    }

    return 0;
}
