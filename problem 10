#include <iostream>
using namespace std;

int main()
{
    int choice;

    cout << "1. Apple" << endl;
    cout << "2. Banana" << endl;
    cout << "3. Mango" << endl;
    cout << "4. Orange" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    switch(choice)
    {
        case 1:
            cout << "You selected Apple.";
            break;

        case 2:
            cout << "You selected Banana.";
            break;

        case 3:
            cout << "You selected Mango.";
            break;

        case 4:
            cout << "You selected Orange.";
            break;

        default:
            cout << "Invalid Choice.";
    }

    return 0;
}
