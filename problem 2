#include <iostream>
using namespace std;

int main()
{
    int marks;
    char passedTest;

    cout << "Enter your marks: ";
    cin >> marks;

    cout << "Did you pass the entry test? (Y/N): ";
    cin >> passedTest;

    if (marks >= 60)
    {
        if (passedTest == 'Y' || passedTest == 'y')
        {
            cout << "Congratulations! You got admission.";
        }
        else
        {
            cout << "You must pass the entry test.";
        }
    }
    else
    {
        cout << "Marks are not enough for admission.";
    }

    return 0;
}
