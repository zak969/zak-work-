#include <iostream>
using namespace std;

int main()
{
    int years;
    char performance;

    cout << "Enter years of service: ";
    cin >> years;

    cout << "Performance is Excellent? (Y/N): ";
    cin >> performance;

    if (years >= 5)
    {
        if (performance == 'Y' || performance == 'y')
        {
            cout << "Employee gets a bonus.";
        }
        else
        {
            cout << "No bonus due to performance.";
        }
    }
    else
    {
        cout << "Not enough years of service.";
    }

    return 0;
}
