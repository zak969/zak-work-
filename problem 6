#include <iostream>
using namespace std;

int main()
{
    int choice;

    cout << "1. Balance Inquiry" << endl;
    cout << "2. Deposit" << endl;
    cout << "3. Withdraw" << endl;
    cout << "4. Exit" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    switch(choice)
    {
        case 1:
            cout << "Balance: Rs. 10,000";
            break;

        case 2:
            cout << "Deposit Selected";
            break;

        case 3:
            cout << "Withdraw Selected";
            break;

        case 4:
            cout << "Thank you!";
            break;

        default:
            cout << "Invalid Choice";
    }

    return 0;
}
